FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    pandas \
    numpy \
    psycopg2-binary \
    scikit-learn \
    shap \
    python-dateutil \
    apscheduler \
    flask

# Copy worker script
COPY dist/server/inference_worker.py .

# Bake in inference scripts and model files
COPY local_pipeline/inference.py          ./worker_files/
COPY local_pipeline/synthetic_generator.py ./worker_files/
COPY cert_pipeline/output/models/          ./worker_files/cert_pipeline/output/models/
COPY cert_pipeline/output/cert_baseline_stats.json ./worker_files/cert_pipeline/output/
COPY cert_pipeline/output/cert_thresholds.json     ./worker_files/cert_pipeline/output/
COPY cert_pipeline/output/model_intake_final.csv   ./worker_files/cert_pipeline/output/

RUN mkdir -p ./worker_files/output

CMD ["python", "inference_worker.py"]