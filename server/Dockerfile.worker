FROM python:3.11-slim

WORKDIR /app

# Install git (needed to clone the repo) and dependencies
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    pandas \
    numpy \
    psycopg2-binary \
    scikit-learn \
    shap \
    python-dateutil \
    apscheduler \
    flask

# 1. Clone the repository into a temporary directory
# (Replace 'main' with your specific branch if needed, e.g., -b installation-script)
RUN git clone -b feat/livelogs https://github.com/rakuda04/preprocessor.git /tmp/repo

# 2. Create the necessary folder structure
RUN mkdir -p ./worker_files/cert_pipeline/output/models \
             ./worker_files/output

# 3. Copy only the files you need from the cloned repo into the working directory
RUN cp /tmp/repo/local_pipeline/inference.py          ./worker_files/ && \
    cp /tmp/repo/local_pipeline/synthetic_generator.py ./worker_files/ && \
    cp -r /tmp/repo/cert_pipeline/output/models/* ./worker_files/cert_pipeline/output/models/ && \
    cp /tmp/repo/cert_pipeline/output/cert_baseline_stats.json ./worker_files/cert_pipeline/output/ && \
    cp /tmp/repo/cert_pipeline/output/cert_thresholds.json     ./worker_files/cert_pipeline/output/ && \
    cp /tmp/repo/cert_pipeline/output/model_intake_final.csv   ./worker_files/cert_pipeline/output/

# 4. Clean up the cloned repo to keep the Docker image size small
RUN rm -rf /tmp/repo

# 5. Copy the local worker script (which lives inside dist/server)
COPY inference_worker.py .
COPY inference.py ./worker_files/
COPY synthetic_generator.py ./worker_files/

CMD ["python", "inference_worker.py"]